# Auto detect text files and perform LF normalization
* text=auto
# Linux service files must keep LF line endings, even when checked out on Windows
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
deploy/thoth.env.example text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
.env.example text eol=lf
