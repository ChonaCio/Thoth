# Thoth service settings, installed to /etc/thoth/thoth.env
# After editing:  sudo systemctl restart thoth

# Port the app listens on.
PORT=3000

# Which address to listen on:
#   127.0.0.1  only this machine. Put nginx/Caddy in front for remote access (see deploy/nginx-thoth.conf).
#   0.0.0.0    every network interface. WARNING: anyone who can reach the port can open the
#              app and install updates. Only use this on a trusted network or behind a firewall.
HOST=127.0.0.1

# Repository that updates come from (owner/name).
# THOTH_UPDATE_REPO=ChonaCio/Thoth

# Optional GitHub token: raises the 60 requests/hour limit and allows private repositories.
# GITHUB_TOKEN=
