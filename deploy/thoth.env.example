# Thoth service settings, installed to /etc/thoth/thoth.env
# After editing:  sudo systemctl restart thoth

# Port the app listens on. Devices connect to http://<server-ip>:PORT
PORT=3000

# Which address to listen on:
#   0.0.0.0    every network interface, so other devices can connect (default)
#   127.0.0.1  only this machine (e.g. when nginx runs on the same server, see deploy/nginx-thoth.conf)
HOST=0.0.0.0

# Repository that updates come from (owner/name).
# THOTH_UPDATE_REPO=ChonaCio/Thoth

# Optional GitHub token: raises the 60 requests/hour limit and allows private repositories.
# GITHUB_TOKEN=
