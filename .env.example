# Settings for docker compose. Copy to .env and edit (.env is never committed or copied into the image).

# Port on the server that devices connect to (http://<server-ip>:THOTH_PORT)
THOTH_PORT=3000

# Password required to install updates from the Updates page. Strongly recommended:
# without it, anyone who can reach the server can install updates.
THOTH_ADMIN_PASSWORD=

# Repository updates come from (owner/name)
THOTH_UPDATE_REPO=ChonaCio/Thoth

# Optional GitHub token: raises the 60 requests/hour limit and allows private repositories
GITHUB_TOKEN=
